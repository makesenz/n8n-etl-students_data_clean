    {
      "parameters": {
        "promptType": "define",
        "text": "=Clean the input student records using these rules:\n- Trim whitespace from all string fields.\n- Convert names and course names to consistent title case; preserve acronyms like UI/UX.\n- Lowercase emails and status values.\n- Preserve enrolled_date exactly.\n- Do not invent missing values or remove any records.\n- Keep all five fields: name, email, course, status, enrolled_date.\n- Do not deduplicate or filter.\n\nReturn only valid JSON matching the configured output schema.\n\nInput:\n{{ JSON.stringify($json) }}",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        448,
        0
      ],
      "id": "ddc6b515-05bd-4c39-9d7d-6c257f361f25",
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "gpt-4.1-mini"
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        448,
        208
      ],
      "id": "583b019a-36fe-44e0-bd0d-5a87992ff96b",
      "name": "OpenAI Chat Model",
      "credentials": {
        "openAiApi": {
          "id": "vKjLWjRxHuJtmdfw",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst results = [];\n\nfor (const item of $input.all()) {\n  let text = item.json.text;\n\n  if (typeof text === \"string\") {\n    text = text\n      .replace(/^```json\\s*/i, \"\")\n      .replace(/\\s*```$/, \"\")\n      .trim();\n  }\n\n  const student = typeof text === \"string\"\n    ? JSON.parse(text)\n    : item.json;\n\n  const clean = value =>\n    typeof value === \"string\" ? value.trim() : \"\";\n\n  const name = clean(student.name);\n  const email = clean(student.email).toLowerCase();\n\n  // Skip records missing name or email\n  if (!name || !email) continue;\n\n  const course = clean(student.course);\n  const status = clean(student.status).toLowerCase();\n  const enrolled_date = clean(student.enrolled_date);\n\n  results.push({\n    json: {\n      name: name.toLowerCase().replace(/\\b\\w/g, c => c.toUpperCase()),\n      email,\n      course,\n      status,\n      enrolled_date,\n    },\n  });\n}\n\nreturn results;\n"
      },
